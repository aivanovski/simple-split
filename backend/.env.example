# http | https
PROTOCOL=https

# Path to SSL certificates, should be specified when running with https protocol
SERVER_CERTIFICATE_PATH=keys/server.crt
SERVER_PRIVATE_KEY_PATH=keys/server.key

# jdbc:sqlite:./app-data/db/simple-split.sqlite?journal_mode=WAL&busy_timeout=30000
# or
# jdbc:sqlite::memory:
DATABASE_URL=jdbc:sqlite:./app-data/db/simple-split.sqlite?journal_mode=WAL&busy_timeout=30000
DATABASE_MAX_POOL_SIZE=4
DATABASE_MIN_IDLE=1

# JWT signing and validation
JWT_SECRET=replace-with-a-secure-random-secret
JWT_ISSUER=simple-split
JWT_AUDIENCE=simple-split
JWT_REALM=simple-split

# When true, populate the database with test data
# true | false
POPULATE_TEST_DATA=true